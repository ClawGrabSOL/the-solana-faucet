# RPC endpoint (mainnet, devnet, or a private RPC)
RPC_URL=https://api.mainnet-beta.solana.com

# Faucet wallet secret key: JSON byte array from solana-keygen
#   [12,34,56,...]   (64 numbers)
# or base58-encoded secret
SOLANA_SECRET_KEY=

# Shown on the page so people can refill the faucet.
# If unset and SOLANA_SECRET_KEY is set, the faucet public key is shown.
FAUCET_DONATE_ADDRESS=DqWPN6zptwMsUda2La6rgQSnfNubkhJJhvVvV3zYSNYv

# Optional. Defaults to 3456.
PORT=3456

# Optional. Cookie signing secret.
SESSION_SECRET=change-me

# Optional. One successful claim per IP and per address in this window (ms).
# Default: 24 hours.
# CLAIM_WINDOW_MS=86400000
